<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>After-Work Schedule & Checklist</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: #171210; color: #f3ede6; line-height: 1.5;
    padding: 16px 14px 60px;
  }
  .wrap { max-width: 560px; margin: 0 auto; }
  header { text-align: center; margin: 12px 0 4px; }
  header h1 { font-size: 1.7rem; margin-bottom: 4px; }
  header p { color: #b8a99b; font-size: 0.95rem; }
  .progress-card {
    background: #241c18; border: 1px solid #3a2f27; border-radius: 14px;
    padding: 14px 16px; margin: 16px 0;
  }
  .progress-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .progress-row strong { font-size: 0.95rem; }
  #progressText { color: #ffb066; font-weight: 700; }
  .bar { height: 10px; background: #171210; border-radius: 6px; overflow: hidden; }
  #barFill { height: 100%; width: 0%; background: linear-gradient(90deg,#ff8c42,#ffb066);
             border-radius: 6px; transition: width .4s ease; }
  .block {
    background: #241c18; border: 1px solid #3a2f27; border-radius: 14px;
    padding: 14px 16px; margin-bottom: 12px;
  }
  .block.now { border-color: #ff8c42; box-shadow: 0 0 0 1px #ff8c42 inset; }
  .block .time {
    font-size: 0.8rem; font-weight: 700; letter-spacing: .04em;
    color: #ffb066; text-transform: uppercase; margin-bottom: 4px;
  }
  .block h2 { font-size: 1.1rem; margin-bottom: 8px; }
  .block .now-badge {
    display: none; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
    background: #ff8c42; color: #1a1512; padding: 2px 8px; border-radius: 8px;
    margin-left: 8px; vertical-align: middle;
  }
  .block.now .now-badge { display: inline-block; }
  label.task {
    display: flex; align-items: flex-start; gap: 10px; padding: 7px 0;
    cursor: pointer; font-size: 0.95rem; -webkit-tap-highlight-color: transparent;
    position: relative;
  }
  /* keep the input real (iOS-safe) but invisible instead of display:none */
  label.task input {
    position: absolute; left: 0; top: 8px; width: 24px; height: 24px;
    opacity: 0; margin: 0; pointer-events: none;
  }
  label.task .box {
    flex: 0 0 auto; width: 22px; height: 22px; border-radius: 7px; margin-top: 1px;
    border: 2px solid #6f5d4d; background: #171210; position: relative;
  }
  label.task.done .box { border-color: #ff8c42; background: #ff8c42; }
  label.task.done .box::after {
    content: ""; position: absolute; left: 6.5px; top: 2.5px; width: 5px; height: 10px;
    border: solid #1a1512; border-width: 0 3px 3px 0; transform: rotate(45deg);
  }
  label.task.done span.txt { text-decoration: line-through; color: #8f7f70; }
  .sub { color: #b8a99b; font-size: 0.85rem; }
  section h3 {
    font-size: 1rem; color: #ffb066; margin: 24px 0 10px;
    text-transform: uppercase; letter-spacing: .05em;
  }
  footer { text-align: center; color: #8f7f70; font-size: 0.8rem; margin-top: 26px; }
  .save-note { color: #6f5d4d; font-size: 0.72rem; }
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>🏠 After-Work Schedule</h1>
  <p>Your handwritten list, coded up. Work it top to bottom — check things off as you go.</p>
</header>
<div class="progress-card">
  <div class="progress-row"><strong>Today's checklist</strong><span id="progressText">0 of 17 done</span></div>
  <div class="bar"><div id="barFill"></div></div>
</div>

<section>
<h3>Afternoon — The routine</h3>

<div class="block" data-start="14:20" data-end="15:00">
  <div class="time">2:20 – 3:00 PM — Home reset<span class="now-badge">now</span></div>
  <h2>Quick reset</h2>
  <label class="task"><input type="checkbox" data-id="laundry"><span class="box"></span><span class="txt">Laundry — start a load first 👕 <span class="sub">(knock it out ASAP)</span></span></label>
  <label class="task"><input type="checkbox" data-id="strawberry"><span class="box"></span><span class="txt">Strawberry drinks 🍓</span></label>
  <label class="task"><input type="checkbox" data-id="yogurt"><span class="box"></span><span class="txt">Prep yogurt for tomorrow's break 🥣 <span class="sub">(takes 2 min)</span></span></label>
  <label class="task"><input type="checkbox" data-id="dishes"><span class="box"></span><span class="txt">Dishes 🍽️</span></label>
  <label class="task"><input type="checkbox" data-id="trash"><span class="box"></span><span class="txt">Trash 🗑️</span></label>
  <label class="task"><input type="checkbox" data-id="clean-car"><span class="box"></span><span class="txt">Clean car (if needed) 🚗 <span class="sub">(parking here for now)</span></span></label>
  <label class="task"><input type="checkbox" data-id="nails"><span class="box"></span><span class="txt">Nails 💅 <span class="sub">(parking here for now)</span></span></label>
</div>

<div class="block" data-start="15:00" data-end="15:15">
  <div class="time">3:00 – 3:15 PM — T-shirt business<span class="now-badge">now</span></div>
  <h2>Side hustle + finances 💼</h2>
  <label class="task"><input type="checkbox" data-id="finances"><span class="box"></span><span class="txt">Finances — balances, payment list 📋</span></label>
  <div class="sub">Product listings, mockups, ad research.</div>
</div>

<div class="block" data-start="15:15" data-end="15:40">
  <div class="time">3:15 PM — Pre-workout snack<span class="now-badge">now</span></div>
  <h2>Fuel up</h2>
  <div class="sub">Whatever's quick — eat it, head out.</div>
</div>

<div class="block" data-start="15:59" data-end="16:00">
  <div class="time">3:59 PM — Weigh-in<span class="now-badge">now</span></div>
  <h2>Scale check ⚖️</h2>
  <label class="task"><input type="checkbox" data-id="weigh-in"><span class="box"></span><span class="txt">Weigh in <span class="sub">(log it, both kg and lbs)</span></span></label>
</div>

<div class="block" data-start="16:00" data-end="16:20">
  <div class="time">4:00 PM — Out the door<span class="now-badge">now</span></div>
  <h2>Head to Gold's Gym 🏋️</h2>
  <div class="sub">~20 min drive. Gym bag, water, keys.</div>
</div>

<div class="block" data-start="16:00" data-end="17:00">
  <div class="time">4:00 – 5:00 PM — Gym<span class="now-badge">now</span></div>
  <h2>Train 💪</h2>
  <label class="task"><input type="checkbox" data-id="gym"><span class="box"></span><span class="txt">Gym — today's session done</span></label>
</div>
<div class="block" data-start="17:00" data-end="17:40">
  <div class="time">5:20 PM — Home, shower, eat<span class="now-badge">now</span></div>
  <h2>Recover 🍲</h2>
  <label class="task"><input type="checkbox" data-id="shower"><span class="box"></span><span class="txt">Shower 🚿</span></label>
  <label class="task"><input type="checkbox" data-id="weekday-foods"><span class="box"></span><span class="txt">Weekday foods — dinner 🍽️</span></label>
</div>

<div class="block" data-start="17:40" data-end="18:40">
  <div class="time">5:40 – 6:40 PM — CompTIA A+<span class="now-badge">now</span></div>
  <h2>Study hour 🖥️</h2>
  <label class="task"><input type="checkbox" data-id="study"><span class="box"></span><span class="txt">CompTIA A+ — 1 hour done</span></label>
  <div class="sub">Week 1: Domains overview + mobile devices (video + notes).</div>
</div>

<div class="block" data-start="18:40" data-end="19:00">
  <div class="time">6:40 PM — Dinner<span class="now-badge">now</span></div>
  <h2>Second meal 🍽️</h2>
  <div class="sub">Weigh it, log it.</div>
</div>

<div class="block" data-start="19:00" data-end="20:00">
  <div class="time">7:00 – 8:00 PM — Wind-down<span class="now-badge">now</span></div>
  <h2>Evening tasks 🌙</h2>
  <label class="task"><input type="checkbox" data-id="stanley"><span class="box"></span><span class="txt">Get Stanley's ready 🥤 <span class="sub">(filled for the morning)</span></span></label>
  <label class="task"><input type="checkbox" data-id="clothes"><span class="box"></span><span class="txt">Lay out tomorrow's clothes 👕</span></label>
  <label class="task"><input type="checkbox" data-id="morning-food"><span class="box"></span><span class="txt">Prep food for the morning 🍱</span></label>
  <label class="task"><input type="checkbox" data-id="emergency-glass"><span class="box"></span><span class="txt">Emergency glass + flavors 🧂 <span class="sub">(bedside water + flavoring)</span></span></label>
</div>

<div class="block" data-start="20:00" data-end="21:00">
  <div class="time">8:00 PM — Bed<span class="now-badge">now</span></div>
  <h2>Lights out 🛌</h2>
  <label class="task"><input type="checkbox" data-id="bed"><span class="box"></span><span class="txt">In bed by 8 PM</span></label>
  <div class="sub">4:30 AM alarm won't snooze itself.</div>
</div>
</section>
<section>
<h3>This week — as needed</h3>
<div class="block">
  <h2>Floating tasks</h2>
  <label class="task"><input type="checkbox" data-id="grocery" data-scope="weekly"><span class="box"></span><span class="txt">Grocery shop 🛒 <span class="sub">(after Friday payday)</span></span></label>
  <label class="task"><input type="checkbox" data-id="meal-prep" data-scope="weekly"><span class="box"></span><span class="txt">Weekday foods prep 🥗</span></label>
  <label class="task"><input type="checkbox" data-id="tshirt" data-scope="weekly"><span class="box"></span><span class="txt">T-shirt business task 👕</span></label>
  <label class="task"><input type="checkbox" data-id="duolingo" data-scope="weekly"><span class="box"></span><span class="txt">Duolingo lesson — before 8AM break 🇪🇸</span></label>
</div>
</section>

<footer>Made by Muse for Joshua · Not every item needs doing daily — it's a sweep, not a mandate.<br><span class="save-note">Checks auto-save on this device · Daily list resets at midnight · Weekly tasks reset Monday</span></footer>
</div>

<script>
(function() {
  "use strict";
  var KEY = "awaSchedule";

  // ---- dates: roll over at LOCAL midnight (old build used UTC ~8PM EDT) ----
  function pad(n) { return ("0" + n).slice(-2); }
  function localDate(d) { return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()); }
  function mondayKey(d) {
    var w = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    w.setDate(w.getDate() - ((w.getDay() + 6) % 7)); // rewind to Monday
    return localDate(w);
  }

  // ---- redundant storage: localStorage mirrored to cookie + window.name ----
  // Reads the first store holding data; writes to every store that accepts it,
  // so one flaky/blocked store can't silently eat progress.
  function cookieGet() {
    try {
      var m = document.cookie.match(new RegExp("(?:^|; )" + KEY + "=([^;]*)"));
      return m ? decodeURIComponent(m[1]) : null;
    } catch (e) { return null; }
  }
  function readRaw() {
    var v = null;
    try { v = window.localStorage && window.localStorage.getItem(KEY); } catch (e) { v = null; }
    if (v) return v;
    v = cookieGet();
    if (v) return v;
    try {
      var n = window.name || "";
      v = n.indexOf(KEY + ":") === 0 ? decodeURIComponent(n.slice(KEY.length + 1)) : null;
    } catch (e) { v = null; }
    return v;
  }
  function writeRaw(v) {
    try { window.localStorage.setItem(KEY, v); } catch (e) {}
    try { document.cookie = KEY + "=" + encodeURIComponent(v) + ";path=/;max-age=31536000;SameSite=Lax"; } catch (e) {}
    try { window.name = KEY + ":" + encodeURIComponent(v); } catch (e) {}
  }

  // ---- scopes: daily items vs the "this week" items ----
  var boxes = document.querySelectorAll('input[type="checkbox"]');
  var scopes = {};
  boxes.forEach(function(box) {
    scopes[box.getAttribute("data-id")] = box.getAttribute("data-scope") === "weekly" ? "weekly" : "daily";
  });

  var today = localDate(new Date());
  var week = mondayKey(new Date());

  var parsed = null;
  try { var r = readRaw(); if (r) parsed = JSON.parse(r); } catch (e) { parsed = null; }

  var daily = { date: today, done: {} };
  var weekly = { week: week, done: {} };

  if (parsed && parsed.daily && parsed.daily.done && parsed.weekly && parsed.weekly.done) {
    // New shape: reset daily at local midnight, weekly on Monday
    daily = parsed.daily; weekly = parsed.weekly;
    if (daily.date !== today) daily = { date: today, done: {} };
    if (weekly.week !== week) weekly = { week: week, done: {} };
  } else if (parsed && parsed.date === today && parsed.done && typeof parsed.done === "object") {
    // Legacy flat shape from the pre-fix build: carry today's checks over,
    // sorting each id into its daily/weekly bucket.
    var leg = parsed;
    Object.keys(leg.done).forEach(function(id) {
      if (leg.done[id]) {
        if (scopes[id] === "weekly") weekly.done[id] = true;
        else daily.done[id] = true;
      }
    });
  }
  var state = { daily: daily, weekly: weekly };
  save(); // normalize + mirror across stores so everything recovers next time

  function bucketOf(box) {
    return scopes[box.getAttribute("data-id")] === "weekly" ? weekly : daily;
  }

  function save() {
    state.daily = daily; state.weekly = weekly;
    try { writeRaw(JSON.stringify(state)); } catch (e) {}
  }

  function update() {
    var doneCount = 0;
    boxes.forEach(function(box) {
      var on = !!bucketOf(box).done[box.getAttribute("data-id")];
      box.checked = on;
      box.closest("label").classList.toggle("done", on);
      if (on) doneCount++;
    });
    var total = boxes.length;
    var pt = document.getElementById("progressText");
    if (pt) pt.textContent = doneCount + " of " + total + " done";
    var bf = document.getElementById("barFill");
    if (bf) bf.style.width = (total ? (doneCount / total) * 100 : 0) + "%";
  }

  boxes.forEach(function(box) {
    box.addEventListener("change", function() {
      var b = bucketOf(box), id = box.getAttribute("data-id");
      if (box.checked) b.done[id] = true;
      else delete b.done[id];
      save(); update();
    });
  });

  // Backstop: flush state before the page hides (mobile browsers can drop late writes)
  document.addEventListener("visibilitychange", function() {
    if (document.visibilityState === "hidden") save();
  });
  window.addEventListener("pagehide", save);

  // Highlight current block by local time
  function nowTag() {
    var d = new Date();
    var t = pad(d.getHours()) + ":" + pad(d.getMinutes());
    var found = false;
    document.querySelectorAll(".block[data-start]").forEach(function(b) {
      var cur = !found && b.getAttribute("data-start") <= t && t < b.getAttribute("data-end");
      b.classList.toggle("now", cur);
      if (cur) found = true;
    });
  }

  update(); nowTag(); setInterval(nowTag, 60000);
})();

</script>
</body>
</html>
